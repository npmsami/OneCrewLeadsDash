# ---------------------------------------------------------------------------
# Job Application Agent — environment config (replaces the n8n "Config" node)
# Copy to .env for local runs; in GitHub Actions these become repo secrets.
# ---------------------------------------------------------------------------

# --- LLM (OpenAI) ---
LLM_API_BASE=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...

# --- Enrichment ---
HUNTER_API_KEY=                 # Starter: 500 domain searches/mo (free tier = 25)
HUNTER_DAILY_CAP=15             # max Hunter searches per UTC day (~450/mo, spreads the 500 quota)
APOLLO_API_KEY=                 # optional; leave blank to skip Apollo fallback

# --- Discovery: JSearch (RapidAPI) ---
JSEARCH_API_KEY=                # RapidAPI key; blank = skip this source
JSEARCH_QUERY=devops cloud sre platform engineer
JSEARCH_NUM_PAGES=1

# --- Storage (Supabase — replaces Google Sheets) ---
SUPABASE_URL=https://dzhnxsgrnohyswhbjthc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=      # service role key (bypasses RLS, like n8n did)

# --- Google (Gmail send + inbox read) ---
# Same web-client creds the dashboard uses. The refresh token is NOT set here:
# the dashboard's Gmail-connect flow stores it in the locked gmail_auth table,
# and agent/google.py reads it from there (service role) to mint access tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=             # from @BotFather (was an n8n credential)
TELEGRAM_CHAT_ID=

# --- Candidate ---
CANDIDATE_NAME=Mahad Saleem
CANDIDATE_EMAIL=you@gmail.com
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/your-handle

# --- Behaviour knobs ---
SEND_EMAILS=false               # false = dry-run (score/enrich/draft, never send)
SEND_THROTTLE_SECONDS=30        # spacing between live sends (deliverability)
MIN_SCORE=70
LOOKBACK_HOURS=168              # past week (n8n default was 48)
MAX_JOBS_PER_RUN=30             # candidates discovered+scored per scrape (free); Hunter still capped at HUNTER_DAILY_CAP

# MASTER_RESUME is large; kept in agent/master_resume.txt rather than an env var.
